# Local Terraform state. May contain secrets in plaintext. Only the
# bootstrap module should ever have local state; every other module uses
# the remote S3 backend that this module creates.
*.tfstate
*.tfstate.*

# Downloaded provider plugins and module cache, regenerated by "terraform init".
# Note: .terraform.lock.hcl is intentionally not ignored. It should be
# committed, since it pins exact provider versions across machines and CI,
# similar to a package-lock.json file.
.terraform/

# Local variable overrides that should not be shared, such as per-machine
# values.
*.auto.tfvars
override.tf
override.tf.json
